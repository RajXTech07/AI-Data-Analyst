# AI Data Analyst - Environment Configuration
# Copy this file to .env and insert your Gemini API Key

# Gemini AI API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Application Configuration
APP_ENV=development
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# Database (default SQLite for zero-setup local dev)
DATABASE_URL=sqlite:///./analyst.db

# File Storage
STORAGE_BACKEND=local
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# Auth
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=15
